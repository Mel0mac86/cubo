{
  "name": "rubik-hero",
  "version": "1.0.0",
  "private": true,
  "description": "Rubik Hero — AI Rubik Cube Solver per bambini 9+",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "icons": "node scripts/make-icons.mjs",
    "build:web": "expo export --platform web --output-dir dist",
    "build:pages": "node scripts/build-pages.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.2.3",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "expo": "~51.0.28",
    "expo-camera": "~15.0.16",
    "expo-gl": "~14.0.2",
    "expo-image-manipulator": "~12.0.5",
    "expo-speech": "~12.0.2",
    "expo-status-bar": "~1.12.1",
    "expo-three": "^8.0.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-web": "~0.19.10",
    "three": "^0.166.1",
    "upng-js": "^2.1.0"
  },
  "devDependencies": {
    "@types/react": "~18.2.79",
    "@types/three": "^0.166.0",
    "typescript": "~5.3.3",
    "vitest": "^2.1.9"
  }
}
