{
  "expo": {
    "name": "Rubik Hero",
    "slug": "rubik-hero",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "rubikhero",
    "assetBundlePatterns": [
      "**/*"
    ],
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#4C1D95",
      "image": "./assets/icon-512.png"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rubikhero.app",
      "infoPlist": {
        "NSCameraUsageDescription": "La fotocamera serve solo per guardare il tuo Cubo di Rubik e riconoscere i colori. Le immagini restano sul telefono e non vengono mai salvate ne inviate.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.rubikhero.app",
      "adaptiveIcon": {
        "backgroundColor": "#4C1D95",
        "foregroundImage": "./assets/icon-maskable-512.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_CONTACTS"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "La fotocamera serve solo per guardare il tuo cubo e riconoscere i colori. Le immagini restano sul telefono.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "extra": {
      "privacy": {
        "collectsPersonalData": false,
        "hasAds": false,
        "hasThirdPartyAnalytics": false,
        "childDirected": true
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Rubik Hero",
      "shortName": "Rubik Hero",
      "lang": "it",
      "themeColor": "#4C1D95",
      "backgroundColor": "#2E1065",
      "display": "standalone",
      "orientation": "portrait",
      "description": "Impara a risolvere il Cubo di Rubik, passo dopo passo, dai 9 anni in su."
    },
    "icon": "./assets/icon-512.png"
  }
}
