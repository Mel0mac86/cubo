# ------------------------------------------------------------------ SERVER
NODE_ENV=development
PORT=4000

# PostgreSQL (obbligatorio)
DATABASE_URL=postgres://cubo:cubo@127.0.0.1:5432/money_adventure

# Segreto per firmare i token di sessione: CAMBIALO in produzione
JWT_SECRET=cambia-questo-segreto-in-produzione
JWT_EXPIRES_IN=30d

# Durata della modalità genitore sbloccata con il PIN (minuti)
PARENT_SESSION_MINUTES=30

# Origini ammesse per il frontend ("*" solo in sviluppo)
CORS_ORIGIN=*

# --------------------------------------------------------- MONEY COACH (AI)
# Facoltativo: senza chiave il Money Coach usa il motore deterministico,
# che fa comunque tutti i calcoli e le simulazioni.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
COACH_AI_ENABLED=true

# Crea il profilo demo (Sofia) all'avvio del server
SEED_ON_BOOT=false

# ------------------------------------------------------------------- TEST
TEST_DATABASE_URL=postgres://cubo:cubo@127.0.0.1:5432/money_adventure_test
